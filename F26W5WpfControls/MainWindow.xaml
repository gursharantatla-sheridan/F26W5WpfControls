<Window x:Class="F26W5WpfControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F26W5WpfControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="16" FontWeight="Bold">
    <Canvas>
        <Canvas Height="72" Width="134" Canvas.Left="26" Canvas.Top="26" Background="#FFF9EFC1" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button Content="Button 1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Button Content="Button 2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Canvas>
        <Image Height="79" Canvas.Left="177" Canvas.Top="19" Width="154" Source="/Car.png" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <GroupBox Height="149" Header="Hobbies" Width="177" Canvas.Left="26" Canvas.Top="114" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel x:Name="spHobbies">
                <CheckBox Content="Gardening" Margin="5"/>
                <CheckBox Content="Singing" Margin="5"/>
                <CheckBox Content="Hiking" Margin="5"/>
                <CheckBox Content="Biking" Margin="5"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="btnGetHobbies" Content="Get Hobbies" Canvas.Left="208" Canvas.Top="136" Height="31" Width="123" Click="btnGetHobbies_Click"/>
        <Label x:Name="lblOutput" Canvas.Left="583" Canvas.Top="261" Height="118" Width="179" Background="#FFC6F5DA"/>

        <GroupBox Height="117" Header="Gender" Width="177" Canvas.Left="26" Canvas.Top="285" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel x:Name="spGender">
                <RadioButton Content="Female" Margin="5"/>
                <RadioButton Content="Male" Margin="5"/>
                <RadioButton Content="Other" Margin="5"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="btnGetGender" Content="Get Gender" Canvas.Left="208" Canvas.Top="304" Height="32" Width="123" HorizontalAlignment="Center" VerticalAlignment="Top" Click="btnGetGender_Click"/>
        <Label Content="Cities" Canvas.Left="414" Canvas.Top="39"/>

        <ComboBox x:Name="cmbCities" Canvas.Left="470" Canvas.Top="43" Width="120" SelectionChanged="cmbCities_SelectionChanged">
            <ComboBoxItem Content="Toronto"/>
            <ComboBoxItem Content="London"/>
            <ComboBoxItem Content="Sydney"/>
            <ComboBoxItem Content="Cape Town"/>
            <ComboBoxItem Content="Tokyo"/>
        </ComboBox>
        <Button x:Name="btnGetCity" Content="Get City" Canvas.Left="595" Canvas.Top="43" Height="27" Width="77" Click="btnGetCity_Click"/>
    </Canvas>
</Window>
